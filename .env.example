# Copy to .env.local and change these values (local dev via: npm run dev)
ADMIN_PASSWORD=change-me

# Supabase (required). Get these from: Supabase dashboard -> Project Settings -> API
# Use the service_role key (secret, server-side only) — never expose it in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Telegram admin notifications (optional). Create a bot via @BotFather to get the
# token, then send the bot a message and read chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates (field: chat.id)
TELEGRAM_BOT_TOKEN=123456:ABC-YourBotToken
TELEGRAM_CHAT_ID=123456789

# Deploy setup:
# 1. Run supabase/schema.sql in the Supabase SQL editor.
# 2. Set ADMIN_PASSWORD, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY as
#    environment variables in Netlify site settings.